# =============================================================================
#  wotnow Â· Cloud Run deployment settings.  EDIT THE <PLACEHOLDERS>, then run the scripts in order.
#  Every script in this folder reads this file. A value that still starts with "<" counts as "not set".
# =============================================================================

# ---- Your GCP project (REQUIRED) ----
PROJECT_ID="project-df7e2989-3b91-42b5-9e1"            # Console â†’ project picker â†’ ID column, e.g. wotnow-hack-2026
BILLING_ACCOUNT_ID="0186CC-180D8B-E458D1"   # only for 10_budget.sh (Console â†’ Billing â†’ Account ID, like 012345-6789AB-CDEF01)
BUDGET_USD="150"                              # budget alert amount for 10_budget.sh

# ---- Where things run ----
REGION="asia-south1"                 # Cloud Run + Cloud Scheduler + Artifact Registry (Mumbai)
FIRESTORE_LOCATION="asia-south1"     # Firestore database location (PERMANENT once created)
VERTEX_LOCATION="us-central1"        # Gemini on Gemini Enterprise Agent Platform (formerly Vertex AI)

# ---- Gemini connection ----
#   vertex  = recommended. Cloud Run's service account calls Agent Platform (Vertex AI). No API key anywhere.
#   apikey  = fallback. Uses a Google AI Studio key stored in Secret Manager.
GEMINI_AUTH="vertex"
GEMINI_MODEL="gemini-2.5-flash"
EMBED_MODEL="text-embedding-005"     # duplicate-post detection (apikey mode: gemini-embedding-001)
AGENT_RUNTIME="adk"                  # adk = Google Agent Development Kit agents Â· direct = roll back to plain Gemini calls

# ---- How the service runs ----
#   always_on : 1 instance, CPU always allocated. The in-app content pipeline, admin "Generate now" and evaluations run
#               continuously. Simplest and works with every feature. Costs the most.
#   economy   : scales to zero, CPU only during requests. Cloud Scheduler wakes it every 10 minutes so the pipeline still
#               posts. Much cheaper, but admin background jobs (Generate now, evaluations) can stall between requests.
RUN_MODE="always_on"
SERVICE="wotnow-app"
RUNTIME_SA_NAME="wotnow-run"
CPU="1"
MEMORY="1Gi"
CONCURRENCY="80"
ALLOW_PUBLIC="true"                  # public website (needed for judges)

# ---- App behaviour ----
DB_BACKEND="firestore"
AUTH_MODE="google"                   # google = Google sign-in + the demo student. (dev = demo only)
ALLOW_DEMO="true"                    # keep "Try the student demo" for judges who don't want to sign in
GOOGLE_CLIENT_ID="633286673637-9aqh8ie1mnmsh8tbb2ui92gulisob2st.apps.googleusercontent.com"
ADMIN_EMAILS="learnarandro@gmail.com"  # comma-separated Google accounts allowed into /#/admin
DATA_MODE="live"                     # live = real weather and air quality (Open-Meteo)
TIMEZONE="Asia/Kolkata"              # streaks, daily limits, quiet hours, the posting schedule
DEMO_CROWD="0"                       # simulated live-quiz players (0 = real players only)
AUTO_SEED="true"                     # load demo content into an EMPTY database on first start
PIPELINE_ENABLED="true"              # in-app content scheduler
PIPELINE_TICK_SECONDS="120"          # how often it looks for due work (each idle pass reads ~13 small documents)
FEED_CACHE_TTL_S="20"                # shared "newest posts" cache: keeps Firestore reads flat as users grow
OVERRIDES_TTL_S="60"                 # how often admin-edited settings are re-read (writes in this instance apply at once)
LLM_CONCURRENCY="4"                  # simultaneous Gemini calls

# ---- Secrets (created by 01_setup_gcp.sh in Secret Manager) ----
JOBS_SECRET="wotnow-jobs-token"           # protects /jobs/* and is the admin token
SESSION_SECRET_NAME="wotnow-session-secret"   # signs Google sign-in sessions
GEMINI_KEY_SECRET="wotnow-gemini-key"     # only if GEMINI_AUTH=apikey
MAPS_KEY_SECRET=""                        # optional: secret holding a Google Air Quality API key

# ---- Safety net / backups ----
CRON_TICK="*/10 * * * *"             # Cloud Scheduler calls POST /jobs/tick (watchdog in always_on, the engine in economy)
ENABLE_BACKUPS="true"                # daily Firestore backup, kept 7 days (best effort, small cost)
