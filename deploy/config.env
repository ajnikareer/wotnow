# =============================================================================
#  wotnow · deployment settings. EDIT THE <PLACEHOLDERS>, then run the scripts in order.
#  All scripts in this folder read this file.
# =============================================================================

# ---- Your GCP project (REQUIRED) ----
PROJECT_ID="<YOUR_GCP_PROJECT_ID>"            # e.g. wotnow-hack-2026  (Console → project picker → ID column)
ALERT_EMAIL="<YOUR_EMAIL_FOR_BUDGET_ALERTS>"  # optional, only printed as a reminder

# ---- Where things run ----
REGION="asia-south1"                 # Cloud Run + Cloud Scheduler + Artifact Registry (Mumbai)
FIRESTORE_LOCATION="asia-south1"     # Firestore database location (permanent once created!)
VERTEX_LOCATION="us-central1"        # Gemini on Vertex AI (widest model availability)

# ---- Gemini connection ----
#   vertex  = recommended. Cloud Run's service account calls Vertex AI. No API key anywhere.
#   apikey  = fallback. Uses a Google AI Studio key stored in Secret Manager.
GEMINI_AUTH="vertex"
GEMINI_MODEL="gemini-2.5-flash"
EMBED_MODEL="text-embedding-005"     # used for duplicate-post detection (apikey mode: gemini-embedding-001)

# ---- Cloud Run service ----
SERVICE="wotnow"
RUNTIME_SA_NAME="wotnow-run"
CPU="1"
MEMORY="1Gi"
MIN_INSTANCES="0"                    # 06_demo_ready.sh sets 1 during judging
MAX_INSTANCES="3"
CONCURRENCY="40"
ALLOW_PUBLIC="true"                  # public website (needed for judges). false = only authenticated callers

# ---- App behaviour ----
AUTH_MODE="dev"                      # dev = demo login (X-Demo-User). firebase = real Google sign-in (not wired in web yet)
DATA_MODE="live"                     # live = real weather/AQI (Open-Meteo); mock = city presets
TIMEZONE="Asia/Kolkata"              # streaks, daily limits, quiet hours, scheduler
DEMO_CROWD="1200"                    # simulated live-quiz players (0 = real players only)
AUTO_SEED="true"                     # load demo content into Firestore on first start

# ---- Secrets (created by 01_setup_gcp.sh in Secret Manager) ----
JOBS_SECRET="wotnow-jobs-token"      # random token Cloud Scheduler uses for /jobs/*
GEMINI_KEY_SECRET="wotnow-gemini-key" # only if GEMINI_AUTH=apikey
MAPS_KEY_SECRET=""                   # optional: name of a secret holding a Google Air Quality API key, e.g. wotnow-maps-key

# ---- Scheduler (cron, in TIMEZONE) ----
CRON_GENERATE="0 */3 * * *"          # new posts from all 8 experts every 3 hours
CRON_ALERTS="30 6 * * *"             # Terra's local city alerts at 06:30
CRON_QUIZ_1="45 12 * * *"            # live quiz at 12:45
CRON_QUIZ_2="45 19 * * *"            # live quiz at 19:45
