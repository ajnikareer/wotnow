# ===== wotnow backend =====  (every switch defaults to offline; flip one at a time)

# ---- Gen AI ----
LLM_PROVIDER=mock                    # gemini | mock
GEMINI_MODEL=gemini-2.5-flash
EMBED_MODEL=text-embedding-005       # Vertex embeddings (AI Studio key: gemini-embedding-001)
GOOGLE_CLOUD_PROJECT=                # set => Gemini via Vertex AI (ADC / Cloud Run service account)
GOOGLE_CLOUD_LOCATION=us-central1
GEMINI_API_KEY=                      # alternative for local testing (aistudio.google.com)
GEN_TEMPERATURE=0.9
JUDGE_TEMPERATURE=0.1

# ---- Local alerts ----
DATA_MODE=mock                       # live (Open-Meteo, free) | mock (city presets)
GOOGLE_MAPS_API_KEY=                 # optional: Google Air Quality API

# ---- Platform ----
DB_BACKEND=memory                    # firestore | memory
AUTH_MODE=dev                        # firebase | dev (trusts X-Demo-User header)
JOBS_TOKEN=change-me
AUTO_SEED=true                       # seed demo content when the DB is empty
TIMEZONE=Asia/Kolkata
DEMO_CROWD=1200                      # simulated live-quiz players (0 = real players only)
